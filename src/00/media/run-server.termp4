## recorded with termp4 rec. Review for secrets before sharing.
#font /usr/share/fonts/truetype/dejavu/DejaVuSansMono.ttf
#font-bold /usr/share/fonts/truetype/dejavu/DejaVuSansMono-Bold.ttf
#font-italic /usr/share/fonts/truetype/dejavu/DejaVuSansMono-Oblique.ttf
#font-bold-italic /usr/share/fonts/truetype/dejavu/DejaVuSansMono-BoldOblique.ttf

#cols 104
#rows 12
#char-speed 40ms
#line-speed 10ms
#raw-speed 10ms

P ~/Desktop/my-jetlag-tutorials $ 
D 80
C npm run serve my_game
D 80
N
L
L > my-jetlag-tutorials@0.0.0 serve
L > jetlag2d serve my_game
L
R \e[1G\e[0K
D 110
R \e[32m\e[39m\r\n
L \e[32mServing at http://localhost:7000/my_game/my_game.html\e[39m
L   - The browser will auto-reload when code, assets, or an HTML file change
L   - Press \e[31mctrl-c\e[39m to stop the server
D 1000
C ^C
N
P ~/Desktop/my-jetlag-tutorials $ 
