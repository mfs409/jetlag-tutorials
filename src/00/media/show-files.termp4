#cols 104
#rows 5
#char-speed 40ms
#line-speed 10ms
#raw-speed 10ms

P ~/Desktop $ 
D 80
C cd my-jetlag-tutorials/
D 80
N
P ~/Desktop/my-jetlag-tutorials $
D 80
C ls
D 80
N
L AGENTS.md  CLAUDE.md  package.json  README.md  tsconfig.json
P ~/Desktop/my-jetlag-tutorials $ 
