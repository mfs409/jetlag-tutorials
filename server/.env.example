# Copy this file to .env and fill in your own values.
#
# GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET come from a Google Cloud OAuth
# "Web application" client -- see README.md for exact steps.  Whatever port
# you run this on, make sure the client's "Authorized redirect URI" is set
# to exactly REDIRECT_URI below.

PORT=3000
REDIRECT_URI=http://localhost:3000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
